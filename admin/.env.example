# ======================================================
# admin/.env.example
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ======================================================

# Neon connection string (เดียวกับ public-site)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret — ใช้รหัสสุ่มยาวๆ อย่างน้อย 32 ตัวอักษร
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-very-long-random-secret-string-here"

# GitHub: สำหรับ trigger rebuild เว็บไซต์สาธารณะ
# สร้าง token ที่: github.com/settings/tokens → New fine-grained token
# Permission: Actions (Read & Write)
GITHUB_ACTIONS_TOKEN="github_pat_xxxxxxxxxxxx"
GITHUB_OWNER="your-github-username"
GITHUB_REPO="your-repo-name"

# Google Drive — ใช้ credentials เดียวกับระบบนโยบาย สพฐ.
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxx"
GOOGLE_REFRESH_TOKEN="1//04xxxxxxxxxxxx"
# ID ของ folder หลักใน Google Drive (สร้างใหม่สำหรับระบบ สมศ.)
GOOGLE_DRIVE_ROOT_FOLDER_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
