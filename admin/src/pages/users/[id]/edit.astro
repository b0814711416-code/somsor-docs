---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminUserById } from '../../../lib/db';

if (Astro.locals.session?.role !== 'admin') return Astro.redirect('/');

const id = Number(Astro.params.id);
const user = await getAdminUserById(id);
if (!user) return Astro.redirect('/users');

const isSelf = Astro.locals.session?.userId === id;
---

<AdminLayout title="แก้ไขผู้ใช้งาน" activeMenu="users">
  <div class="max-w-lg">
    <a href="/users" class="flex items-center gap-1 text-sm text-gray-500 hover:text-blue-600 mb-6 transition-colors">
      ← กลับรายการผู้ใช้งาน
    </a>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="text-lg font-bold text-gray-800">แก้ไขผู้ใช้งาน</h2>
        {isSelf && <span class="text-xs bg-green-100 text-green-700 font-semibold px-2.5 py-1 rounded-full">บัญชีของคุณ</span>}
      </div>

      <div id="successMsg" class="hidden mb-4 p-3 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-sm text-green-700">✅ บันทึกเรียบร้อยแล้ว!</p>
      </div>
      <div id="errorMsg" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-600" id="errorText"></p>
      </div>

      <form id="editForm" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">อีเมล</label>
          <input type="text" value={user.email} disabled
                 class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-400 cursor-not-allowed"/>
          <p class="text-xs text-gray-400 mt-1">ไม่สามารถเปลี่ยนอีเมลได้</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อที่แสดง</label>
          <input type="text" name="display_name" value={user.display_name ?? ''} placeholder="เช่น นายสมชาย ใจดี"
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">รหัสผ่านใหม่ <span class="text-gray-400 text-xs">(เว้นว่างถ้าไม่ต้องการเปลี่ยน)</span></label>
          <input type="password" name="password" placeholder="อย่างน้อย 6 ตัวอักษร"
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>

        {!isSelf && (
          <>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">ประเภทผู้ใช้งาน</label>
              <div class="grid grid-cols-2 gap-3">
                <label class="flex items-start gap-3 border border-blue-200 rounded-lg p-3 cursor-pointer hover:bg-blue-50 transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
                  <input type="radio" name="role" value="teacher" checked={user.role !== 'admin'} class="mt-0.5 accent-blue-600"/>
                  <div>
                    <p class="text-sm font-semibold text-gray-700">👩‍🏫 ครู</p>
                    <p class="text-xs text-gray-400 mt-0.5">จัดการเอกสาร มาตรฐาน ตัวชี้วัด</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 border border-purple-200 rounded-lg p-3 cursor-pointer hover:bg-purple-50 transition-colors has-[:checked]:border-purple-500 has-[:checked]:bg-purple-50">
                  <input type="radio" name="role" value="admin" checked={user.role === 'admin'} class="mt-0.5 accent-purple-600"/>
                  <div>
                    <p class="text-sm font-semibold text-gray-700">👑 Admin</p>
                    <p class="text-xs text-gray-400 mt-0.5">ทุกสิทธิ์ รวมถึงจัดการผู้ใช้งาน</p>
                  </div>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">สถานะ</label>
              <div class="flex gap-4">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="is_active" value="true" checked={user.is_active} class="accent-blue-600"/>
                  <span class="text-sm text-gray-700">ใช้งาน</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="is_active" value="false" checked={!user.is_active} class="accent-blue-600"/>
                  <span class="text-sm text-gray-700">ปิดใช้งาน</span>
                </label>
              </div>
            </div>
          </>
        )}

        <div class="flex gap-3 pt-2">
          <button type="submit" id="submitBtn"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition-colors disabled:opacity-60">
            บันทึก
          </button>
          <a href="/users" class="px-6 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-600 hover:bg-gray-50 transition-colors text-center">
            ยกเลิก
          </a>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ userId: id, isSelf }}>
    const form       = document.getElementById('editForm');
    const submitBtn  = document.getElementById('submitBtn');
    const successMsg = document.getElementById('successMsg');
    const errorMsg   = document.getElementById('errorMsg');
    const errorText  = document.getElementById('errorText');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const raw = Object.fromEntries(new FormData(form));

      const payload = { display_name: raw.display_name };
      if (raw.password) payload.password = raw.password;
      if (!isSelf) {
        payload.is_active = raw.is_active === 'true';
        payload.role = raw.role;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังบันทึก...';
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      try {
        const res = await fetch(`/api/users/${userId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (res.ok) {
          successMsg.classList.remove('hidden');
        } else {
          errorText.textContent = json.error || 'เกิดข้อผิดพลาด';
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorText.textContent = 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้';
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'บันทึก';
      }
    });
  </script>
</AdminLayout>
