---
import AdminLayout from '../../layouts/AdminLayout.astro';

if (Astro.locals.session?.role !== 'admin') return Astro.redirect('/');
---

<AdminLayout title="เพิ่มผู้ใช้งาน" activeMenu="users">
  <div class="max-w-lg">
    <a href="/users" class="flex items-center gap-1 text-sm text-gray-500 hover:text-blue-600 mb-6 transition-colors">
      ← กลับรายการผู้ใช้งาน
    </a>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
      <h2 class="text-lg font-bold text-gray-800 mb-6">เพิ่มผู้ใช้งานใหม่</h2>

      <div id="successMsg" class="hidden mb-4 p-3 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-sm text-green-700">✅ เพิ่มผู้ใช้งานเรียบร้อยแล้ว! <a href="/users" class="underline font-medium">ดูรายการผู้ใช้งาน</a></p>
      </div>
      <div id="errorMsg" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-600" id="errorText"></p>
      </div>

      <form id="userForm" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อที่แสดง</label>
          <input type="text" name="display_name" placeholder="เช่น นายสมชาย ใจดี"
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">อีเมล <span class="text-red-500">*</span></label>
          <input type="email" name="email" required placeholder="example@school.ac.th"
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">รหัสผ่าน <span class="text-red-500">*</span></label>
          <input type="password" name="password" required placeholder="อย่างน้อย 6 ตัวอักษร" minlength="6"
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">ยืนยันรหัสผ่าน <span class="text-red-500">*</span></label>
          <input type="password" name="confirm_password" required placeholder="กรอกรหัสผ่านอีกครั้ง"
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">ประเภทผู้ใช้งาน <span class="text-red-500">*</span></label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-start gap-3 border border-blue-200 rounded-lg p-3 cursor-pointer hover:bg-blue-50 transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
              <input type="radio" name="role" value="teacher" checked class="mt-0.5 accent-blue-600"/>
              <div>
                <p class="text-sm font-semibold text-gray-700">👩‍🏫 ครู</p>
                <p class="text-xs text-gray-400 mt-0.5">จัดการเอกสาร มาตรฐาน ตัวชี้วัด</p>
              </div>
            </label>
            <label class="flex items-start gap-3 border border-purple-200 rounded-lg p-3 cursor-pointer hover:bg-purple-50 transition-colors has-[:checked]:border-purple-500 has-[:checked]:bg-purple-50">
              <input type="radio" name="role" value="admin" class="mt-0.5 accent-purple-600"/>
              <div>
                <p class="text-sm font-semibold text-gray-700">👑 Admin</p>
                <p class="text-xs text-gray-400 mt-0.5">ทุกสิทธิ์ รวมถึงจัดการผู้ใช้งาน</p>
              </div>
            </label>
          </div>
        </div>

        <div class="flex gap-3 pt-2">
          <button type="submit" id="submitBtn"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition-colors disabled:opacity-60">
            เพิ่มผู้ใช้งาน
          </button>
          <a href="/users" class="px-6 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-600 hover:bg-gray-50 transition-colors text-center">
            ยกเลิก
          </a>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    const form       = document.getElementById('userForm');
    const submitBtn  = document.getElementById('submitBtn');
    const successMsg = document.getElementById('successMsg');
    const errorMsg   = document.getElementById('errorMsg');
    const errorText  = document.getElementById('errorText');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));

      if (data.password !== data.confirm_password) {
        errorText.textContent = 'รหัสผ่านไม่ตรงกัน';
        errorMsg.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังบันทึก...';
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      try {
        const res = await fetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: data.email, password: data.password, display_name: data.display_name, role: data.role }),
        });
        const json = await res.json();
        if (res.ok) {
          successMsg.classList.remove('hidden');
          form.reset();
        } else {
          errorText.textContent = json.error || 'เกิดข้อผิดพลาด';
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorText.textContent = 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้';
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'เพิ่มผู้ใช้งาน';
      }
    });
  </script>
</AdminLayout>
