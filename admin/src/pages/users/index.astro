---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllAdminUsers } from '../../lib/db';

if (Astro.locals.session?.role !== 'admin') return Astro.redirect('/');

const users = await getAllAdminUsers();
const session = Astro.locals.session;
---

<AdminLayout title="จัดการผู้ใช้งาน" activeMenu="users">
  <div class="max-w-3xl">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-bold text-gray-800">ผู้ใช้งานระบบ Admin</h2>
      <a href="/users/new"
         class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
        ➕ เพิ่มผู้ใช้งาน
      </a>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">ผู้ใช้งาน</th>
            <th class="text-center px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">ประเภท</th>
            <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">เข้าสู่ระบบล่าสุด</th>
            <th class="text-center px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">สถานะ</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {users.map(u => (
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-5 py-3">
                <div class="flex items-center gap-3">
                  <div class={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0
                    ${u.role === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'}`}>
                    {(u.display_name || u.email)[0].toUpperCase()}
                  </div>
                  <div>
                    <p class="font-medium text-gray-800">{u.display_name || '—'}</p>
                    <p class="text-xs text-gray-400">{u.email}</p>
                  </div>
                  {u.id === session?.userId && (
                    <span class="text-xs bg-green-100 text-green-700 font-semibold px-2 py-0.5 rounded-full">คุณ</span>
                  )}
                </div>
              </td>
              <td class="px-5 py-3 text-center">
                <span class={`text-xs font-bold px-2.5 py-1 rounded-full
                  ${u.role === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'}`}>
                  {u.role === 'admin' ? '👑 Admin' : '👩‍🏫 ครู'}
                </span>
              </td>
              <td class="px-5 py-3 text-gray-500 text-xs">
                {u.last_login_at
                  ? new Date(u.last_login_at).toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })
                  : 'ยังไม่เคยเข้า'}
              </td>
              <td class="px-5 py-3 text-center">
                <span class={`text-xs font-bold px-2.5 py-1 rounded-full ${u.is_active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}`}>
                  {u.is_active ? 'ใช้งาน' : 'ปิดใช้'}
                </span>
              </td>
              <td class="px-5 py-3 text-right">
                <div class="flex items-center justify-end gap-3">
                  <a href={`/users/${u.id}/edit`} class="text-xs text-blue-600 hover:underline">แก้ไข</a>
                  {u.id !== session?.userId && (
                    <button
                      data-delete-id={u.id}
                      data-delete-name={u.display_name || u.email}
                      class="text-xs text-red-500 hover:underline delete-btn">
                      ลบ
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id   = btn.dataset.deleteId;
        const name = btn.dataset.deleteName;
        if (!confirm(`ลบผู้ใช้งาน "${name}" ใช่ไหม?\nการดำเนินการนี้ไม่สามารถย้อนกลับได้`)) return;
        const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
        if (res.ok) {
          btn.closest('tr').remove();
        } else {
          const json = await res.json();
          alert('❌ ' + (json.error || 'เกิดข้อผิดพลาด'));
        }
      });
    });
  </script>
</AdminLayout>
