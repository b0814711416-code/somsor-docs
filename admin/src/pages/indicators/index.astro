---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllIndicators, getAllStandards } from '../../lib/db';

const [indicators, standards] = await Promise.all([getAllIndicators(), getAllStandards()]);

const basicStdIds = new Set(standards.filter(s => s.education_level === 'basic').map(s => s.id));
const earlyStdIds = new Set(standards.filter(s => s.education_level === 'early').map(s => s.id));

const basicInds = indicators.filter(i => basicStdIds.has(i.standard_id));
const earlyInds = indicators.filter(i => earlyStdIds.has(i.standard_id));
---

<AdminLayout title="จัดการตัวชี้วัด" activeMenu="indicators">

  <div class="flex justify-end mb-6">
    <a href="/indicators/new"
       class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white
              text-sm font-medium px-4 py-2 rounded-lg transition-colors">
      ➕ เพิ่มตัวชี้วัดใหม่
    </a>
  </div>

  {[
    { label: 'ขั้นพื้นฐาน', inds: basicInds, color: 'blue' },
    { label: 'ปฐมวัย',     inds: earlyInds, color: 'pink'  },
  ].map(({ label, inds, color }) => (
    <div class="mb-8">
      <h2 class="text-base font-bold text-gray-700 mb-3 flex items-center gap-2">
        <span class={`bg-${color}-100 text-${color}-700 text-xs font-bold px-2.5 py-1 rounded-full`}>{label}</span>
        {inds.length} ตัวชี้วัด
      </h2>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        {inds.length === 0 ? (
          <div class="text-center py-10 text-gray-400 text-sm">ยังไม่มีตัวชี้วัด</div>
        ) : (
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-200 text-left">
                <th class="px-4 py-3 font-semibold text-gray-600">รหัส</th>
                <th class="px-4 py-3 font-semibold text-gray-600">ชื่อตัวชี้วัด</th>
                <th class="px-4 py-3 font-semibold text-gray-600">มาตรฐาน</th>
                <th class="px-4 py-3 font-semibold text-gray-600">ลำดับ</th>
                <th class="px-4 py-3 font-semibold text-gray-600 text-right">จัดการ</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {inds.map(i => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 font-bold text-gray-700">{i.code}</td>
                  <td class="px-4 py-3">
                    <p class="font-medium text-gray-800">{i.name}</p>
                    {i.description && <p class="text-xs text-gray-400 mt-0.5 line-clamp-1">{i.description}</p>}
                  </td>
                  <td class="px-4 py-3 text-xs text-gray-500">{i.standard_name}</td>
                  <td class="px-4 py-3 text-gray-500">{i.sort_order}</td>
                  <td class="px-4 py-3 text-right space-x-3">
                    <a href={`/indicators/${i.id}/edit`} class="text-blue-600 hover:underline text-xs">แก้ไข</a>
                    <button class="delete-btn text-red-500 hover:text-red-700 text-xs"
                            data-id={i.id} data-name={i.name}>ลบ</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  ))}

  <script is:inline>
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm(`ต้องการลบตัวชี้วัด "${btn.dataset.name}" ใช่ไหม?\nเอกสารที่เชื่อมโยงจะถูกลบด้วย`)) return;
        const res = await fetch(`/api/indicators/${btn.dataset.id}`, { method: 'DELETE' });
        if (res.ok) { window.location.reload(); }
        else { alert('เกิดข้อผิดพลาดในการลบ'); }
      });
    });
  </script>
</AdminLayout>
