---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getIndicatorById, getAlbumsByIndicator, getAllStandards } from '../../../lib/db';

const id = Number(Astro.params.id);
const [indicator, standards] = await Promise.all([getIndicatorById(id), getAllStandards()]);
if (!indicator) return Astro.redirect('/indicators');

const standard = standards.find(s => s.id === indicator.standard_id);
const level = standard?.education_level ?? 'basic';
const albums = await getAlbumsByIndicator(id);
const MAX_PHOTOS = 10;
---

<AdminLayout title={`คลังภาพ: ${indicator.code}`} activeMenu="indicators">
  <div class="max-w-4xl">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
      <a href="/indicators" class="hover:text-blue-600 transition-colors">ตัวชี้วัด</a>
      <span>›</span>
      <span class="text-gray-700 font-medium">คลังภาพ: ตัวชี้วัดที่ {indicator.code}</span>
    </div>

    <!-- Header -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 mb-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-gray-800">คลังภาพ — ตัวชี้วัดที่ {indicator.code}</h2>
          <p class="text-sm text-gray-500 mt-0.5">{indicator.name}</p>
        </div>
        <span class={`text-xs font-semibold px-3 py-1 rounded-full ${level === 'early' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'}`}>
          {level === 'early' ? '🌸 ปฐมวัย' : '🎓 ขั้นพื้นฐาน'}
        </span>
      </div>
    </div>

    <!-- Create Album -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 mb-6">
      <h3 class="text-sm font-bold text-gray-700 mb-3">สร้างคลังภาพใหม่</h3>
      <div id="albumCreateError" class="hidden mb-3 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-600"></div>
      <div class="flex gap-3">
        <input id="albumNameInput" type="text" placeholder="ชื่อคลังภาพ เช่น กิจกรรมวันแม่ 2567"
               class="flex-1 px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500"/>
        <button id="createAlbumBtn"
                class="px-4 py-2.5 bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold rounded-lg transition-colors disabled:opacity-60">
          + สร้างคลัง
        </button>
      </div>
      <p class="text-xs text-gray-400 mt-2">แต่ละคลังรองรับรูปภาพสูงสุด {MAX_PHOTOS} รูป</p>
    </div>

    <!-- Albums list -->
    <div id="albumsList">
      {albums.length === 0 ? (
        <div class="text-center py-14 bg-white rounded-xl border border-dashed border-gray-300">
          <p class="text-3xl mb-2">🖼️</p>
          <p class="text-gray-500 text-sm">ยังไม่มีคลังภาพ — สร้างคลังแรกด้านบน</p>
        </div>
      ) : (
        albums.map(album => (
          <div class="album-card bg-white rounded-xl border border-gray-200 shadow-sm mb-4 overflow-hidden"
               data-album-id={album.id}>
            <!-- Album header -->
            <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100 bg-gray-50">
              <div>
                <p class="font-semibold text-gray-800 text-sm">📷 {album.name}</p>
                <p class="text-xs text-gray-400 mt-0.5">{album.photos?.length ?? 0} / {MAX_PHOTOS} รูป</p>
              </div>
              <div class="flex items-center gap-3">
                {(album.photos?.length ?? 0) < MAX_PHOTOS && (
                  <label class="cursor-pointer flex items-center gap-1.5 text-xs font-medium text-purple-700 hover:text-purple-900 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    เพิ่มรูป
                    <input type="file" accept="image/*" class="hidden photo-upload-input" data-album={album.id}/>
                  </label>
                )}
                <button class="delete-album-btn text-xs text-red-500 hover:text-red-700 transition-colors"
                        data-id={album.id} data-name={album.name}>
                  ลบคลัง
                </button>
              </div>
            </div>

            <!-- Photos grid -->
            <div class="p-4">
              {album.photos && album.photos.length > 0 ? (
                <div class={`grid gap-2 grid-cols-5`} id={`photos-grid-${album.id}`}>
                  {album.photos.map(photo => (
                    <div class="relative group aspect-square rounded-lg overflow-hidden bg-gray-100"
                         data-photo-id={photo.id}>
                      <img src={photo.url} alt="ภาพหลักฐาน"
                           class="w-full h-full object-cover"/>
                      <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <button class="delete-photo-btn p-1.5 bg-red-500 rounded-full text-white"
                                data-photo-id={photo.id} data-album-id={album.id}>
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="text-center py-6 text-gray-400 text-xs" id={`photos-grid-${album.id}`}>
                  ยังไม่มีรูปภาพ — คลิก "เพิ่มรูป" เพื่อเริ่ม
                </div>
              )}
              <!-- Upload progress -->
              <div class={`upload-progress hidden mt-3 p-3 bg-purple-50 border border-purple-200 rounded-lg`}
                   id={`progress-${album.id}`}>
                <p class="text-xs text-purple-700 font-medium">กำลังอัปโหลด...</p>
                <div class="mt-1.5 h-1.5 bg-purple-100 rounded-full overflow-hidden">
                  <div class="h-full bg-purple-500 rounded-full animate-pulse w-full"></div>
                </div>
              </div>
            </div>
          </div>
        ))
      )}
    </div>
  </div>

  <script is:inline define:vars={{ indicatorId: id, level }}>
    const MAX = 10;

    // ── สร้างคลังใหม่ ──
    document.getElementById('createAlbumBtn').addEventListener('click', async () => {
      const input = document.getElementById('albumNameInput');
      const errEl = document.getElementById('albumCreateError');
      const name = input.value.trim();
      if (!name) { input.focus(); return; }

      const btn = document.getElementById('createAlbumBtn');
      btn.disabled = true; btn.textContent = 'กำลังสร้าง...';
      errEl.classList.add('hidden');

      try {
        const res = await fetch('/api/albums', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ indicator_id: indicatorId, name, level }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'เกิดข้อผิดพลาด');
        window.location.reload();
      } catch (e) {
        errEl.textContent = e.message;
        errEl.classList.remove('hidden');
        btn.disabled = false; btn.textContent = '+ สร้างคลัง';
      }
    });

    // Enter key สร้าง album
    document.getElementById('albumNameInput').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('createAlbumBtn').click();
    });

    // ── ลบคลัง ──
    document.querySelectorAll('.delete-album-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm(`ลบคลังภาพ "${btn.dataset.name}" และรูปทั้งหมดใช่ไหม?`)) return;
        const res = await fetch(`/api/albums/${btn.dataset.id}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
        else alert('เกิดข้อผิดพลาดในการลบ');
      });
    });

    // ── อัปโหลดรูป ──
    document.querySelectorAll('.photo-upload-input').forEach(input => {
      input.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const albumId = input.dataset.album;
        const progress = document.getElementById(`progress-${albumId}`);
        const grid = document.getElementById(`photos-grid-${albumId}`);

        progress.classList.remove('hidden');
        input.disabled = true;

        try {
          const form = new FormData();
          form.append('photo', file);
          const res = await fetch(`/api/albums/${albumId}/photos`, { method: 'POST', body: form });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'อัปโหลดล้มเหลว');

          // แทนที่ placeholder text ถ้ายังอยู่
          if (grid.tagName === 'DIV' && !grid.querySelector('div[data-photo-id]')) {
            grid.innerHTML = '';
            grid.className = 'grid gap-2 grid-cols-5';
          }

          // เพิ่มภาพใหม่เข้า grid
          const cell = document.createElement('div');
          cell.className = 'relative group aspect-square rounded-lg overflow-hidden bg-gray-100';
          cell.dataset.photoId = data.id;
          cell.innerHTML = `
            <img src="${data.url}" alt="ภาพหลักฐาน" class="w-full h-full object-cover"/>
            <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <button class="delete-photo-btn p-1.5 bg-red-500 rounded-full text-white"
                      data-photo-id="${data.id}" data-album-id="${albumId}">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>`;
          grid.appendChild(cell);
          attachDeletePhoto(cell.querySelector('.delete-photo-btn'));

          // อัปเดต counter
          const card = document.querySelector(`[data-album-id="${albumId}"]`);
          const counter = card?.querySelector('.text-xs.text-gray-400');
          if (counter) {
            const current = grid.querySelectorAll('[data-photo-id]').length;
            counter.textContent = `${current} / ${MAX} รูป`;
            if (current >= MAX) input.closest('label')?.remove();
          }
        } catch (err) {
          alert(err.message);
        } finally {
          progress.classList.add('hidden');
          input.disabled = false;
          input.value = '';
        }
      });
    });

    // ── ลบรูปภาพ ──
    function attachDeletePhoto(btn) {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (!confirm('ลบรูปภาพนี้?')) return;
        const photoId = btn.dataset.photoId;
        const albumId = btn.dataset.albumId;
        const res = await fetch(`/api/albums/${albumId}/photos/${photoId}`, { method: 'DELETE' });
        if (res.ok) {
          const cell = btn.closest('[data-photo-id]');
          const grid = cell?.parentElement;
          cell?.remove();
          // อัปเดต counter
          const card = document.querySelector(`.album-card[data-album-id="${albumId}"]`);
          const counter = card?.querySelector('.text-xs.text-gray-400');
          if (counter && grid) {
            const current = grid.querySelectorAll('[data-photo-id]').length;
            counter.textContent = `${current} / ${MAX} รูป`;
          }
        } else {
          alert('เกิดข้อผิดพลาดในการลบรูป');
        }
      });
    }
    document.querySelectorAll('.delete-photo-btn').forEach(attachDeletePhoto);
  </script>
</AdminLayout>
