---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getStandardById } from '../../../lib/db';

const id = Number(Astro.params.id);
const standard = await getStandardById(id);
if (!standard) return Astro.redirect('/standards');

const COLORS = ['blue','green','purple','orange','red','pink','yellow','teal'];
const ICONS  = ['🎓','📚','⚙️','🏆','📋','🌟','💡','🔬','🎨','🏫','📊','✅'];
---

<AdminLayout title="แก้ไขมาตรฐาน" activeMenu="standards">
  <div class="max-w-2xl">
    <a href="/standards" class="flex items-center gap-1 text-sm text-gray-500 hover:text-blue-600 mb-6 transition-colors">
      ← กลับรายการมาตรฐาน
    </a>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
      <h2 class="text-lg font-bold text-gray-800 mb-6">แก้ไขมาตรฐาน</h2>

      <div id="successMsg" class="hidden mb-4 p-3 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-sm text-green-700">✅ บันทึกการแก้ไขเรียบร้อยแล้ว!</p>
      </div>
      <div id="errorMsg" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-600" id="errorText"></p>
      </div>

      <form id="stdForm" class="space-y-5">

        <!-- ระดับการศึกษา -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">ระดับการศึกษา</label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="education_level" value="basic"
                     checked={standard.education_level === 'basic'} class="accent-blue-600"/>
              <span class="text-sm font-medium text-blue-700 bg-blue-50 px-3 py-1 rounded-full">การศึกษาขั้นพื้นฐาน</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="education_level" value="early"
                     checked={standard.education_level === 'early'} class="accent-pink-600"/>
              <span class="text-sm font-medium text-pink-700 bg-pink-50 px-3 py-1 rounded-full">ปฐมวัย</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">รหัสมาตรฐาน <span class="text-red-500">*</span></label>
            <input type="text" name="code" required value={standard.code}
                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">ลำดับการแสดงผล</label>
            <input type="number" name="sort_order" value={standard.sort_order} min="0"
                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อมาตรฐาน <span class="text-red-500">*</span></label>
          <input type="text" name="name" required value={standard.name}
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">คำอธิบาย</label>
          <textarea name="description" rows="2"
                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none">{standard.description}</textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">ไอคอน</label>
            <select name="icon" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              {ICONS.map(ic => <option value={ic} selected={ic === standard.icon}>{ic}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">สีธีม</label>
            <select name="color" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              {COLORS.map(c => <option value={c} selected={c === standard.color}>{c}</option>)}
            </select>
          </div>
        </div>

        <div class="flex gap-3 pt-2">
          <button type="submit" id="submitBtn"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition-colors disabled:opacity-60">
            บันทึกการแก้ไข
          </button>
          <a href="/standards" class="px-6 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-600 hover:bg-gray-50 transition-colors text-center">
            ยกเลิก
          </a>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ stdId: id }}>
    const form = document.getElementById('stdForm');
    const submitBtn = document.getElementById('submitBtn');
    const successMsg = document.getElementById('successMsg');
    const errorMsg = document.getElementById('errorMsg');
    const errorText = document.getElementById('errorText');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังบันทึก...';
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      const data = Object.fromEntries(new FormData(form));
      try {
        const res = await fetch(`/api/standards/${stdId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, sort_order: Number(data.sort_order) || 0 }),
        });
        const json = await res.json();
        if (res.ok) {
          successMsg.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          errorText.textContent = json.error || 'เกิดข้อผิดพลาด';
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorText.textContent = 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้';
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'บันทึกการแก้ไข';
      }
    });
  </script>
</AdminLayout>
