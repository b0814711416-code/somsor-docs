---
/**
 * Admin Dashboard — ภาพรวมสถิติและรายการเอกสารล่าสุด
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import { getAllDocuments, getAllStandards } from '../lib/db';

const [documents, standards] = await Promise.all([getAllDocuments(), getAllStandards()]);

const activeCount   = documents.filter(d => d.is_active).length;
const inactiveCount = documents.length - activeCount;

// จัดกลุ่มตาม standard แยก level
const basicStandards = standards
  .filter(s => s.education_level === 'basic')
  .map(s => ({ ...s, count: documents.filter(d => d.standard_code === s.code).length }));

const earlyStandards = standards
  .filter(s => s.education_level === 'early')
  .map(s => ({ ...s, count: documents.filter(d => d.standard_code === s.code).length }));

const basicDocCount  = basicStandards.reduce((sum, s) => sum + s.count, 0);
const earlyDocCount  = earlyStandards.reduce((sum, s) => sum + s.count, 0);

// เอกสาร 10 รายการล่าสุด
const recentDocs = [...documents]
  .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())
  .slice(0, 10);
---

<AdminLayout title="ภาพรวม" activeMenu="dashboard">

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
      <p class="text-3xl font-bold text-blue-600">{documents.length}</p>
      <p class="text-sm text-gray-500 mt-1">เอกสารทั้งหมด</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
      <p class="text-3xl font-bold text-green-600">{activeCount}</p>
      <p class="text-sm text-gray-500 mt-1">เอกสารที่แสดงอยู่</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
      <p class="text-3xl font-bold text-gray-400">{inactiveCount}</p>
      <p class="text-sm text-gray-500 mt-1">ซ่อนอยู่</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
      <p class="text-3xl font-bold text-purple-600">{standards.length}</p>
      <p class="text-sm text-gray-500 mt-1">มาตรฐาน</p>
    </div>
  </div>

  <!-- เอกสารแยกตาม standard -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8">

    <!-- ขั้นพื้นฐาน -->
    <div class="bg-white rounded-xl border border-blue-100 p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg">🎓</span>
        <h2 class="font-bold text-gray-700">มาตรฐานการศึกษาขั้นพื้นฐาน</h2>
        <span class="ml-auto text-xs font-semibold bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">{basicDocCount} เอกสาร</span>
      </div>
      <div class="space-y-3">
        {basicStandards.map(s => (
          <div class="flex items-center gap-3">
            <span class="w-24 text-sm text-gray-600 shrink-0">มาตรฐาน {s.code}</span>
            <div class="flex-1 bg-gray-100 rounded-full h-4 overflow-hidden">
              <div
                class="bg-blue-500 h-4 rounded-full transition-all"
                style={`width: ${basicDocCount ? Math.round(s.count / basicDocCount * 100) : 0}%`}
              ></div>
            </div>
            <span class="w-8 text-right text-sm font-semibold text-gray-700">{s.count}</span>
          </div>
        ))}
        {basicStandards.length === 0 && (
          <p class="text-sm text-gray-400 text-center py-2">ยังไม่มีมาตรฐาน</p>
        )}
      </div>
    </div>

    <!-- ปฐมวัย -->
    <div class="bg-white rounded-xl border border-pink-100 p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg">🌸</span>
        <h2 class="font-bold text-gray-700">มาตรฐานการศึกษาปฐมวัย</h2>
        <span class="ml-auto text-xs font-semibold bg-pink-100 text-pink-700 px-2 py-0.5 rounded-full">{earlyDocCount} เอกสาร</span>
      </div>
      <div class="space-y-3">
        {earlyStandards.map(s => (
          <div class="flex items-center gap-3">
            <span class="w-24 text-sm text-gray-600 shrink-0">มาตรฐาน {s.code}</span>
            <div class="flex-1 bg-gray-100 rounded-full h-4 overflow-hidden">
              <div
                class="bg-pink-500 h-4 rounded-full transition-all"
                style={`width: ${earlyDocCount ? Math.round(s.count / earlyDocCount * 100) : 0}%`}
              ></div>
            </div>
            <span class="w-8 text-right text-sm font-semibold text-gray-700">{s.count}</span>
          </div>
        ))}
        {earlyStandards.length === 0 && (
          <p class="text-sm text-gray-400 text-center py-2">ยังไม่มีมาตรฐาน</p>
        )}
      </div>
    </div>

  </div>

  <!-- เอกสารล่าสุด -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
      <h2 class="font-bold text-gray-700">เพิ่มล่าสุด</h2>
      <a href="/documents" class="text-sm text-blue-600 hover:underline">ดูทั้งหมด →</a>
    </div>
    <div class="divide-y divide-gray-50">
      {recentDocs.map(doc => (
        <div class="flex items-center gap-4 px-5 py-3 hover:bg-gray-50 transition-colors">
          <span class={`flex-shrink-0 text-xs font-bold px-2 py-0.5 rounded-full
                       ${doc.is_active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}`}>
            {doc.is_active ? 'แสดง' : 'ซ่อน'}
          </span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-800 truncate">{doc.title}</p>
            <p class="text-xs text-gray-400 mt-0.5">
              มาตรฐาน {doc.standard_code} › ตัวชี้วัด {doc.indicator_code}
              · ปีการศึกษา {doc.academic_year}
            </p>
          </div>
          <a href={`/documents/${doc.id}/edit`}
             class="text-xs text-blue-600 hover:underline flex-shrink-0">แก้ไข</a>
        </div>
      ))}
    </div>
  </div>

  <!-- Quick actions -->
  <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-3">
    <a href="/standards"
       class="flex flex-col items-center gap-2 bg-white border border-gray-200 hover:border-blue-400
              hover:shadow-md rounded-xl p-4 transition-all text-center">
      <span class="text-2xl">🏆</span>
      <span class="text-sm font-medium text-gray-700">จัดการมาตรฐาน</span>
    </a>
    <a href="/indicators"
       class="flex flex-col items-center gap-2 bg-white border border-gray-200 hover:border-green-400
              hover:shadow-md rounded-xl p-4 transition-all text-center">
      <span class="text-2xl">📋</span>
      <span class="text-sm font-medium text-gray-700">จัดการตัวชี้วัด</span>
    </a>
    <a href="/documents"
       class="flex flex-col items-center gap-2 bg-white border border-gray-200 hover:border-gray-400
              hover:shadow-md rounded-xl p-4 transition-all text-center">
      <span class="text-2xl">📂</span>
      <span class="text-sm font-medium text-gray-700">จัดการเอกสาร</span>
    </a>
    <a href="/documents/new?level=basic"
       class="flex flex-col items-center gap-2 bg-blue-600 hover:bg-blue-700
              rounded-xl p-4 transition-all text-center">
      <span class="text-2xl">📄</span>
      <span class="text-sm font-medium text-white">เพิ่มเอกสาร (ขั้นพื้นฐาน)</span>
    </a>
    <a href="/documents/new?level=early"
       class="flex flex-col items-center gap-2 bg-pink-600 hover:bg-pink-700
              rounded-xl p-4 transition-all text-center col-span-2 sm:col-span-1">
      <span class="text-2xl">🌸</span>
      <span class="text-sm font-medium text-white">เพิ่มเอกสาร (ปฐมวัย)</span>
    </a>
  </div>
</AdminLayout>
