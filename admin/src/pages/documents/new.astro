---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllIndicators, getAllStandards, getAllTags } from '../../lib/db';

const level = Astro.url.searchParams.get('level') ?? 'basic';
const isEarly = level === 'early';
const levelLabel = isEarly ? 'ปฐมวัย' : 'การศึกษาขั้นพื้นฐาน';

const [allIndicators, standards, allTags] = await Promise.all([
  getAllIndicators(), getAllStandards(), getAllTags(),
]);

const levelStdIds = new Set(
  standards.filter(s => s.education_level === level).map(s => s.id)
);
const indicators = allIndicators.filter(i => levelStdIds.has(i.standard_id));

const grouped = indicators.reduce((acc, ind) => {
  const key = ind.standard_name ?? 'อื่นๆ';
  if (!acc[key]) acc[key] = [];
  acc[key].push(ind);
  return acc;
}, {} as Record<string, typeof indicators>);

const DOC_TYPES = ['รายงาน', 'แผน', 'คำสั่ง', 'ภาพถ่าย', 'สถิติ', 'สรุป', 'นวัตกรรม', 'เอกสาร'];
const currentYear = new Date().getFullYear() + 543;
const years = [currentYear, currentYear - 1, currentYear - 2].map(String);
---

<AdminLayout title={`เพิ่มเอกสารใหม่ — ${levelLabel}`} activeMenu="documents">

  <div class="max-w-2xl">
    <a href="/documents" class="flex items-center gap-1 text-sm text-gray-500 hover:text-blue-600 mb-6 transition-colors">
      ← กลับรายการเอกสาร
    </a>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="text-lg font-bold text-gray-800">เพิ่มเอกสารหลักฐานใหม่</h2>
        <span class={`text-xs font-bold px-2.5 py-1 rounded-full ${isEarly ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'}`}>
          {isEarly ? '🌸 ปฐมวัย' : '🎓 ขั้นพื้นฐาน'}
        </span>
      </div>

      <div id="successMsg" class="hidden mb-4 p-3 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-sm text-green-700">✅ บันทึกเรียบร้อยแล้ว!</p>
      </div>
      <div id="errorMsg" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-600" id="errorText"></p>
      </div>

      <form id="newDocForm" class="space-y-5">

        <!-- ตัวชี้วัด -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            ตัวชี้วัด / ประเด็นพิจารณา <span class="text-red-500">*</span>
          </label>
          <select name="indicator_id" required
                  class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm bg-white
                         focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">-- เลือกตัวชี้วัด --</option>
            {Object.entries(grouped).map(([stdName, inds]) => (
              <optgroup label={stdName}>
                {inds.map(ind => (
                  <option value={ind.id}>
                    {ind.code}: {ind.name}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>

        <!-- ชื่อเอกสาร -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            ชื่อเอกสาร <span class="text-red-500">*</span>
          </label>
          <input
            type="text" name="title" required
            placeholder="เช่น รายงานผลสัมฤทธิ์ทางการเรียน ปีการศึกษา 2567"
            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm
                   focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- แหล่งที่มาไฟล์ -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">ไฟล์เอกสาร</label>

          <!-- Toggle -->
          <div class="flex gap-1 mb-4 bg-gray-100 p-1 rounded-lg w-fit">
            <button type="button" id="btnUpload"
                    class="px-4 py-1.5 rounded-md text-sm font-medium transition-colors
                           bg-white text-blue-700 shadow-sm">
              อัปโหลดไฟล์
            </button>
            <button type="button" id="btnUrl"
                    class="px-4 py-1.5 rounded-md text-sm font-medium transition-colors
                           text-gray-500 hover:text-gray-700">
              วางลิงก์เอง
            </button>
          </div>

          <!-- อัปโหลดไฟล์ -->
          <div id="uploadSection">
            <div id="dropzone"
                 class="border-2 border-dashed border-blue-300 rounded-xl p-6 text-center
                        cursor-pointer hover:border-blue-500 hover:bg-blue-50 transition-colors">
              <div id="dropzoneIdle">
                <div class="text-3xl mb-2">📁</div>
                <p class="text-sm font-medium text-gray-700">
                  ลากไฟล์มาวางที่นี่ หรือ
                  <span class="text-blue-600 underline">คลิกเลือกไฟล์</span>
                </p>
                <p class="text-xs text-gray-400 mt-1">PDF, Word, Excel, PowerPoint, รูปภาพ — สูงสุด 50 MB</p>
              </div>
              <div id="dropzoneFile" class="hidden">
                <div class="text-3xl mb-1">📄</div>
                <p id="fileNameDisplay" class="text-sm font-semibold text-gray-800 break-all"></p>
                <p id="fileSizeDisplay" class="text-xs text-gray-500 mt-0.5"></p>
                <button type="button" id="clearFile"
                        class="mt-2 text-xs text-red-500 hover:text-red-700 underline">
                  เปลี่ยนไฟล์
                </button>
              </div>
            </div>
            <input type="file" id="fileInput" class="hidden"
                   accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.gif,.mp4,.zip" />

            <div id="uploadProgress" class="hidden mt-3">
              <div class="flex items-center gap-2 text-sm text-blue-700">
                <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"
                          stroke-dasharray="20 60"/>
                </svg>
                <span id="uploadProgressText">กำลังสร้าง folder และอัปโหลดไฟล์...</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-1.5 mt-2">
                <div id="progressBar" class="bg-blue-600 h-1.5 rounded-full transition-all"
                     style="width:10%"></div>
              </div>
            </div>

            <div id="uploadSuccess" class="hidden mt-3 p-3 bg-green-50 border border-green-200 rounded-lg">
              <p class="text-sm text-green-700 font-medium">✅ อัปโหลดสำเร็จแล้ว!</p>
              <p class="text-xs text-gray-600 mt-0.5">
                ไฟล์ถูกบันทึกใน Google Drive folder
                <strong id="folderPathDisplay"></strong>
              </p>
              <a id="driveFileLink" href="#" target="_blank" rel="noopener"
                 class="text-xs text-blue-600 underline mt-1 inline-block">
                ดูไฟล์ใน Google Drive →
              </a>
            </div>

            <p class="text-xs text-gray-400 mt-2">
              ระบบจะสร้าง folder
              <strong>{isEarly ? 'ปฐมวัย' : 'ขั้นพื้นฐาน'} → ตัวชี้วัด</strong>
              ใน Google Drive อัตโนมัติ
            </p>
          </div>

          <!-- URL เอง -->
          <div id="urlSection" class="hidden">
            <input
              type="url" name="url" id="urlInput"
              placeholder="https://drive.google.com/file/d/..."
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm
                     focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <p class="text-xs text-gray-400 mt-1">
              วิธีรับลิงก์: Google Drive → คลิกขวาที่ไฟล์ → "รับลิงก์" → "ทุกคนที่มีลิงก์ดูได้"
            </p>
          </div>
        </div>

        <!-- ประเภท + ปีการศึกษา -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">ประเภทเอกสาร</label>
            <select name="doc_type"
                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm bg-white
                           focus:outline-none focus:ring-2 focus:ring-blue-500">
              {DOC_TYPES.map(t => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">ปีการศึกษา</label>
            <select name="academic_year"
                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm bg-white
                           focus:outline-none focus:ring-2 focus:ring-blue-500">
              {years.map(y => <option value={y}>{y}</option>)}
            </select>
          </div>
        </div>

        <!-- ป้ายกำกับ (Tags) -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            ป้ายกำกับ (Tag) <span class="text-gray-400 text-xs">(พิมพ์แล้วกด Enter หรือ , เพื่อเพิ่ม)</span>
          </label>
          <div id="tagBox"
               class="flex flex-wrap items-center gap-2 px-2 py-1.5 border border-gray-300 rounded-lg
                      bg-white focus-within:ring-2 focus-within:ring-blue-500 cursor-text">
            <input type="text" id="tagInput" list="tagSuggestions" autocomplete="off"
                   placeholder="เช่น สำคัญ, ตรวจแล้ว, รอบ 5"
                   class="flex-1 min-w-[140px] outline-none text-sm py-1 bg-transparent"/>
          </div>
          <datalist id="tagSuggestions">
            {allTags.map(t => <option value={t}/>)}
          </datalist>
          <p class="text-xs text-gray-400 mt-1">ใช้จัดกลุ่ม/ค้นหาเอกสารในภายหลัง</p>
        </div>

        <!-- ลำดับ -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            ลำดับการแสดงผล <span class="text-gray-400 text-xs">(น้อย = แสดงก่อน)</span>
          </label>
          <input
            type="number" name="sort_order" value="0" min="0"
            class="w-32 px-3 py-2.5 border border-gray-300 rounded-lg text-sm
                   focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Buttons -->
        <div class="flex gap-3 pt-2">
          <button type="submit" id="submitBtn"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold
                         py-2.5 rounded-lg transition-colors disabled:opacity-60">
            บันทึกเอกสาร
          </button>
          <a href="/documents"
             class="px-6 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-600
                    hover:bg-gray-50 transition-colors text-center">
            ยกเลิก
          </a>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ level }}>
    const form            = document.getElementById('newDocForm');
    const submitBtn       = document.getElementById('submitBtn');
    const successMsg      = document.getElementById('successMsg');
    const errorMsg        = document.getElementById('errorMsg');
    const errorText       = document.getElementById('errorText');

    // Toggle sections
    const btnUpload       = document.getElementById('btnUpload');
    const btnUrl          = document.getElementById('btnUrl');
    const uploadSection   = document.getElementById('uploadSection');
    const urlSection      = document.getElementById('urlSection');
    const urlInput        = document.getElementById('urlInput');

    // Upload UI
    const dropzone        = document.getElementById('dropzone');
    const dropzoneIdle    = document.getElementById('dropzoneIdle');
    const dropzoneFile    = document.getElementById('dropzoneFile');
    const fileInput       = document.getElementById('fileInput');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const fileSizeDisplay = document.getElementById('fileSizeDisplay');
    const clearFile       = document.getElementById('clearFile');
    const uploadProgress  = document.getElementById('uploadProgress');
    const progressBar     = document.getElementById('progressBar');
    const uploadSuccess   = document.getElementById('uploadSuccess');
    const driveFileLink   = document.getElementById('driveFileLink');
    const folderPathDisplay = document.getElementById('folderPathDisplay');

    let selectedFile = null;
    let uploadedUrl  = null;    // URL จาก Drive หลัง upload สำเร็จ
    let sourceMode   = 'upload'; // 'upload' | 'url'

    // ---- Tag chip input ----
    const tagBox   = document.getElementById('tagBox');
    const tagInput = document.getElementById('tagInput');
    let tags = [];

    function renderTags() {
      // ลบ chip เดิม (เก็บ input ไว้)
      tagBox.querySelectorAll('.tag-chip').forEach(el => el.remove());
      tags.forEach((tag, idx) => {
        const chip = document.createElement('span');
        chip.className = 'tag-chip inline-flex items-center gap-1 bg-blue-100 text-blue-700 ' +
                         'text-xs font-medium px-2 py-1 rounded-full';
        const label = document.createElement('span');
        label.textContent = tag;
        const x = document.createElement('button');
        x.type = 'button';
        x.textContent = '×';
        x.className = 'text-blue-500 hover:text-blue-800 font-bold leading-none';
        x.addEventListener('click', () => { tags.splice(idx, 1); renderTags(); });
        chip.append(label, x);
        tagBox.insertBefore(chip, tagInput);
      });
    }

    function addTag(value) {
      const tag = (value || '').trim();
      if (!tag) return;
      if (!tags.some(t => t.toLowerCase() === tag.toLowerCase())) tags.push(tag);
      tagInput.value = '';
      renderTags();
    }

    tagBox?.addEventListener('click', () => tagInput?.focus());
    tagInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        addTag(tagInput.value);
      } else if (e.key === 'Backspace' && !tagInput.value && tags.length) {
        tags.pop();
        renderTags();
      }
    });
    // เลือกจาก datalist (suggestion) แล้วเพิ่มอัตโนมัติ
    tagInput?.addEventListener('change', () => { if (tagInput.value) addTag(tagInput.value); });
    tagInput?.addEventListener('blur', () => addTag(tagInput.value));

    // ---- Toggle mode ----
    function setMode(mode) {
      sourceMode = mode;
      if (mode === 'upload') {
        btnUpload.classList.add('bg-white', 'text-blue-700', 'shadow-sm');
        btnUpload.classList.remove('text-gray-500');
        btnUrl.classList.remove('bg-white', 'text-blue-700', 'shadow-sm');
        btnUrl.classList.add('text-gray-500');
        uploadSection.classList.remove('hidden');
        urlSection.classList.add('hidden');
        urlInput.removeAttribute('required');
      } else {
        btnUrl.classList.add('bg-white', 'text-blue-700', 'shadow-sm');
        btnUrl.classList.remove('text-gray-500');
        btnUpload.classList.remove('bg-white', 'text-blue-700', 'shadow-sm');
        btnUpload.classList.add('text-gray-500');
        urlSection.classList.remove('hidden');
        uploadSection.classList.add('hidden');
        urlInput.setAttribute('required', '');
      }
    }

    btnUpload?.addEventListener('click', () => setMode('upload'));
    btnUrl?.addEventListener('click', () => setMode('url'));

    // ---- File picker / drag-drop ----
    function formatSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function showFile(file) {
      selectedFile = file;
      uploadedUrl  = null;
      fileNameDisplay.textContent = file.name;
      fileSizeDisplay.textContent = formatSize(file.size);
      dropzoneIdle.classList.add('hidden');
      dropzoneFile.classList.remove('hidden');
      uploadSuccess.classList.add('hidden');
      uploadProgress.classList.add('hidden');
    }

    function clearFileState() {
      selectedFile = null;
      uploadedUrl  = null;
      fileInput.value = '';
      dropzoneFile.classList.add('hidden');
      dropzoneIdle.classList.remove('hidden');
      uploadSuccess.classList.add('hidden');
    }

    dropzone?.addEventListener('click', () => fileInput?.click());
    clearFile?.addEventListener('click', (e) => { e.stopPropagation(); clearFileState(); });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files[0]) showFile(fileInput.files[0]);
    });

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-blue-500', 'bg-blue-50');
    });
    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-blue-500', 'bg-blue-50');
    });
    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-blue-500', 'bg-blue-50');
      const file = e.dataTransfer?.files[0];
      if (file) showFile(file);
    });

    // ---- อัปโหลดไฟล์ไป Drive ----
    async function uploadToDrive() {
      if (!selectedFile) throw new Error('กรุณาเลือกไฟล์ก่อน');

      const indicatorId = form.querySelector('[name="indicator_id"]').value;
      if (!indicatorId) throw new Error('กรุณาเลือกตัวชี้วัดก่อน');

      const title = form.querySelector('[name="title"]').value.trim();
      if (!title) throw new Error('กรุณากรอกชื่อเอกสารก่อน');

      uploadProgress.classList.remove('hidden');
      progressBar.style.width = '20%';

      const fd = new FormData();
      fd.append('file', selectedFile);
      fd.append('indicator_id', indicatorId);
      fd.append('level', level);
      fd.append('title', title);
      fd.append('doc_type', form.querySelector('[name="doc_type"]').value);
      fd.append('academic_year', form.querySelector('[name="academic_year"]').value);
      fd.append('sort_order', form.querySelector('[name="sort_order"]').value || '0');
      fd.append('tags', tags.join(','));

      progressBar.style.width = '50%';

      const res = await fetch('/api/documents/upload', { method: 'POST', body: fd });
      const json = await res.json();

      progressBar.style.width = '100%';

      if (!res.ok) throw new Error(json.error || 'อัปโหลดไม่สำเร็จ');

      uploadProgress.classList.add('hidden');
      uploadedUrl = json.url;

      // แสดง success
      uploadSuccess.classList.remove('hidden');
      driveFileLink.href = json.url;
      const levelName = level === 'early' ? 'ปฐมวัย' : 'ขั้นพื้นฐาน';
      folderPathDisplay.textContent = `${levelName} → ตัวชี้วัดที่เลือก`;

      return json; // doc record ที่บันทึก DB แล้ว
    }

    // ---- Submit form ----
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      try {
        if (sourceMode === 'upload') {
          // อัปโหลดไฟล์ + บันทึก DB ใน endpoint เดียว
          submitBtn.textContent = 'กำลังอัปโหลด...';
          await uploadToDrive();
          successMsg.classList.remove('hidden');
          successMsg.querySelector('p').textContent = '✅ อัปโหลดและบันทึกเรียบร้อยแล้ว!';
          form.reset();
          clearFileState();
          tags = []; renderTags();
          uploadSuccess.classList.add('hidden');
        } else {
          // กรอก URL เอง — ใช้ API เดิม
          submitBtn.textContent = 'กำลังบันทึก...';
          const data = Object.fromEntries(new FormData(form));
          if (!data.url) throw new Error('กรุณากรอก URL');
          const res = await fetch('/api/documents', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...data,
              indicator_id: Number(data.indicator_id),
              sort_order:   Number(data.sort_order) || 0,
              tags,
            }),
          });
          const json = await res.json();
          if (!res.ok) throw new Error(json.error || 'เกิดข้อผิดพลาด');
          successMsg.classList.remove('hidden');
          successMsg.querySelector('p').textContent = '✅ บันทึกเรียบร้อยแล้ว!';
          form.reset();
          tags = []; renderTags();
        }
        successMsg.scrollIntoView({ behavior: 'smooth' });

      } catch (err) {
        errorText.textContent = err.message || 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้';
        errorMsg.classList.remove('hidden');
        uploadProgress.classList.add('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'บันทึกเอกสาร';
      }
    });
  </script>
</AdminLayout>
