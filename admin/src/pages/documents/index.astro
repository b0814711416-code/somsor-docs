---
/**
 * หน้ารายการเอกสารทั้งหมด — ค้นหา, กรองตาม standard, สลับ active/inactive
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllDocuments } from '../../lib/db';

const documents = await getAllDocuments();

// กรองตาม query parameter
const filterStandard = Astro.url.searchParams.get('standard') ?? '';
const filterYear     = Astro.url.searchParams.get('year') ?? '';
const showInactive   = Astro.url.searchParams.get('inactive') === '1';

// ปีการศึกษาที่มีในระบบ (สำหรับ dropdown)
const years = [...new Set(documents.map(d => d.academic_year))].sort().reverse();
---

<AdminLayout title="จัดการเอกสาร" activeMenu="documents">

  <!-- Toolbar -->
  <div class="flex flex-wrap items-center gap-3 mb-6">
    <!-- Filter by standard -->
    <form method="GET" class="flex items-center gap-2">
      <select name="standard" onchange="this.form.submit()"
              class="text-sm border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">ทุกมาตรฐาน</option>
        <option value="1" selected={filterStandard === '1'}>มาตรฐาน 1</option>
        <option value="2" selected={filterStandard === '2'}>มาตรฐาน 2</option>
        <option value="3" selected={filterStandard === '3'}>มาตรฐาน 3</option>
      </select>

      <select name="year" onchange="this.form.submit()"
              class="text-sm border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">ทุกปีการศึกษา</option>
        {years.map(y => <option value={y} selected={filterYear === y}>{y}</option>)}
      </select>

      <label class="flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer">
        <input type="checkbox" name="inactive" value="1" checked={showInactive}
               onchange="this.form.submit()" class="rounded"/>
        แสดงที่ซ่อนอยู่ด้วย
      </label>
    </form>

    <div class="ml-auto">
      <a href="/documents/new"
         class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white
                text-sm font-medium px-4 py-2 rounded-lg transition-colors">
        <span>➕</span> เพิ่มใหม่
      </a>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-left">
            <th class="px-4 py-3 font-semibold text-gray-600">ชื่อเอกสาร</th>
            <th class="px-4 py-3 font-semibold text-gray-600">มาตรฐาน / ตัวบ่งชี้</th>
            <th class="px-4 py-3 font-semibold text-gray-600">ประเภท</th>
            <th class="px-4 py-3 font-semibold text-gray-600">ปี</th>
            <th class="px-4 py-3 font-semibold text-gray-600">สถานะ</th>
            <th class="px-4 py-3 font-semibold text-gray-600 text-right">จัดการ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100" id="docTable">
          {documents
            .filter(d => !filterStandard || d.standard_code === filterStandard)
            .filter(d => !filterYear || d.academic_year === filterYear)
            .filter(d => showInactive ? true : d.is_active)
            .map(doc => (
              <tr class={`hover:bg-gray-50 transition-colors ${!doc.is_active ? 'opacity-50' : ''}`}
                  data-id={doc.id}>
                <td class="px-4 py-3">
                  <p class="font-medium text-gray-800 leading-snug max-w-xs truncate">{doc.title}</p>
                  <a href={doc.url} target="_blank"
                     class="text-xs text-blue-500 hover:underline truncate block max-w-xs">
                    ดูเอกสาร ↗
                  </a>
                </td>
                <td class="px-4 py-3 text-gray-600 whitespace-nowrap">
                  <span class="text-xs font-medium bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">
                    มาตรฐาน {doc.standard_code}
                  </span>
                  <br/>
                  <span class="text-xs text-gray-500 mt-0.5 inline-block">
                    ตัวบ่งชี้ {doc.indicator_code}
                  </span>
                </td>
                <td class="px-4 py-3 text-gray-600 text-xs">{doc.doc_type}</td>
                <td class="px-4 py-3 text-gray-600 text-xs">{doc.academic_year}</td>
                <td class="px-4 py-3">
                  <button
                    class="toggle-btn text-xs font-medium px-2.5 py-1 rounded-full transition-colors cursor-pointer"
                    class:list={[doc.is_active
                      ? 'bg-green-100 text-green-700 hover:bg-green-200'
                      : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                    ]}
                    data-id={doc.id}
                    data-active={doc.is_active ? '1' : '0'}
                  >
                    {doc.is_active ? 'แสดง' : 'ซ่อน'}
                  </button>
                </td>
                <td class="px-4 py-3 text-right space-x-2 whitespace-nowrap">
                  <a href={`/documents/${doc.id}/edit`}
                     class="text-blue-600 hover:underline text-xs">แก้ไข</a>
                  <button
                    class="delete-btn text-red-500 hover:text-red-700 text-xs"
                    data-id={doc.id}
                    data-title={doc.title}
                  >
                    ลบ
                  </button>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      {documents.length === 0 && (
        <div class="text-center py-16 text-gray-400">
          <p class="text-4xl mb-2">📭</p>
          <p>ยังไม่มีเอกสาร — <a href="/documents/new" class="text-blue-600 hover:underline">เพิ่มเอกสารใหม่</a></p>
        </div>
      )}
    </div>
  </div>

  <script>
    // Toggle active/inactive
    document.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id     = btn.dataset.id;
        const active = btn.dataset.active === '1';

        const res = await fetch(`/api/documents/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_active: !active }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('เกิดข้อผิดพลาด');
        }
      });
    });

    // Delete
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id    = btn.dataset.id;
        const title = btn.dataset.title;

        if (!confirm(`ต้องการลบเอกสาร "${title}" ใช่ไหม?\nการลบไม่สามารถกู้คืนได้`)) return;

        const res = await fetch(`/api/documents/${id}`, { method: 'DELETE' });

        if (res.ok) {
          btn.closest('tr')?.remove();
        } else {
          alert('เกิดข้อผิดพลาดในการลบ');
        }
      });
    });
  </script>
</AdminLayout>
