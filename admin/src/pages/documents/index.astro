---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllDocuments, getAllStandards } from '../../lib/db';

const [documents, standards] = await Promise.all([getAllDocuments(), getAllStandards()]);

const level      = Astro.url.searchParams.get('level') ?? 'basic';
const isEarly    = level === 'early';
const filterStd  = Astro.url.searchParams.get('standard') ?? '';
const filterYear = Astro.url.searchParams.get('year') ?? '';
const showInactive = Astro.url.searchParams.get('inactive') === '1';

const levelDocs = documents.filter(d => (d.education_level ?? 'basic') === level);

const levelStandards = standards.filter(s => s.education_level === level);
const years = [...new Set(levelDocs.map(d => d.academic_year))].sort().reverse();

const filtered = levelDocs
  .filter(d => !filterStd  || d.standard_code === filterStd)
  .filter(d => !filterYear || d.academic_year === filterYear)
  .filter(d => showInactive ? true : d.is_active);
---

<AdminLayout title="จัดการเอกสาร" activeMenu="documents">

  <!-- Level Tabs -->
  <div class="flex gap-1 mb-6 bg-gray-100 p-1 rounded-xl w-fit">
    <a href="/documents?level=basic"
       class={`flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-colors
              ${!isEarly ? 'bg-white text-blue-700 shadow-sm' : 'text-gray-500 hover:text-gray-700'}`}>
      🎓 การศึกษาขั้นพื้นฐาน
      <span class={`text-xs px-1.5 py-0.5 rounded-full font-bold
        ${!isEarly ? 'bg-blue-100 text-blue-700' : 'bg-gray-200 text-gray-500'}`}>
        {documents.filter(d => (d.education_level ?? 'basic') === 'basic').length}
      </span>
    </a>
    <a href="/documents?level=early"
       class={`flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-colors
              ${isEarly ? 'bg-white text-pink-700 shadow-sm' : 'text-gray-500 hover:text-gray-700'}`}>
      🌸 ปฐมวัย
      <span class={`text-xs px-1.5 py-0.5 rounded-full font-bold
        ${isEarly ? 'bg-pink-100 text-pink-700' : 'bg-gray-200 text-gray-500'}`}>
        {documents.filter(d => d.education_level === 'early').length}
      </span>
    </a>
  </div>

  <!-- Toolbar -->
  <div class="flex flex-wrap items-center gap-3 mb-4">
    <form method="GET" class="flex items-center gap-2">
      <input type="hidden" name="level" value={level}/>

      <select name="standard" onchange="this.form.submit()"
              class="text-sm border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">ทุกมาตรฐาน</option>
        {levelStandards.map(s => (
          <option value={s.code} selected={filterStd === s.code}>มาตรฐาน {s.code}</option>
        ))}
      </select>

      <select name="year" onchange="this.form.submit()"
              class="text-sm border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">ทุกปีการศึกษา</option>
        {years.map(y => <option value={y} selected={filterYear === y}>{y}</option>)}
      </select>

      <label class="flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer">
        <input type="checkbox" name="inactive" value="1" checked={showInactive}
               onchange="this.form.submit()" class="rounded"/>
        แสดงที่ซ่อนอยู่ด้วย
      </label>
    </form>

    <div class="ml-auto">
      <a href={`/documents/new?level=${level}`}
         class={`flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors
                ${isEarly ? 'bg-pink-600 hover:bg-pink-700' : 'bg-blue-600 hover:bg-blue-700'}`}>
        ➕ เพิ่มใหม่
      </a>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class={`border-b border-gray-200 text-left ${isEarly ? 'bg-pink-50' : 'bg-blue-50'}`}>
            <th class="px-4 py-3 font-semibold text-gray-600">ชื่อเอกสาร</th>
            <th class="px-4 py-3 font-semibold text-gray-600">มาตรฐาน / ตัวชี้วัด</th>
            <th class="px-4 py-3 font-semibold text-gray-600">ประเภท</th>
            <th class="px-4 py-3 font-semibold text-gray-600">ปี</th>
            <th class="px-4 py-3 font-semibold text-gray-600">สถานะ</th>
            <th class="px-4 py-3 font-semibold text-gray-600 text-right">จัดการ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100" id="docTable">
          {filtered.map(doc => (
            <tr class={`hover:bg-gray-50 transition-colors ${!doc.is_active ? 'opacity-50' : ''}`}
                data-id={doc.id}>
              <td class="px-4 py-3">
                <p class="font-medium text-gray-800 leading-snug max-w-xs truncate">{doc.title}</p>
                <a href={doc.url} target="_blank"
                   class="text-xs text-blue-500 hover:underline truncate block max-w-xs">
                  ดูเอกสาร ↗
                </a>
              </td>
              <td class="px-4 py-3 text-gray-600 whitespace-nowrap">
                <span class={`text-xs font-medium px-2 py-0.5 rounded-full
                  ${isEarly ? 'bg-pink-50 text-pink-700' : 'bg-blue-50 text-blue-700'}`}>
                  มาตรฐาน {doc.standard_code}
                </span>
                <br/>
                <span class="text-xs text-gray-500 mt-0.5 inline-block">
                  ตัวชี้วัด {doc.indicator_code}
                </span>
              </td>
              <td class="px-4 py-3 text-gray-600 text-xs">{doc.doc_type}</td>
              <td class="px-4 py-3 text-gray-600 text-xs">{doc.academic_year}</td>
              <td class="px-4 py-3">
                <button
                  class="toggle-btn text-xs font-medium px-2.5 py-1 rounded-full transition-colors cursor-pointer"
                  class:list={[doc.is_active
                    ? 'bg-green-100 text-green-700 hover:bg-green-200'
                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                  ]}
                  data-id={doc.id}
                  data-active={doc.is_active ? '1' : '0'}
                >
                  {doc.is_active ? 'แสดง' : 'ซ่อน'}
                </button>
              </td>
              <td class="px-4 py-3 text-right space-x-2 whitespace-nowrap">
                <a href={`/documents/${doc.id}/edit`}
                   class="text-blue-600 hover:underline text-xs">แก้ไข</a>
                <button
                  class="delete-btn text-red-500 hover:text-red-700 text-xs"
                  data-id={doc.id}
                  data-title={doc.title}
                >
                  ลบ
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {filtered.length === 0 && (
        <div class="text-center py-16 text-gray-400">
          <p class="text-4xl mb-2">📭</p>
          <p>ยังไม่มีเอกสาร — <a href={`/documents/new?level=${level}`} class="text-blue-600 hover:underline">เพิ่มเอกสารใหม่</a></p>
        </div>
      )}
    </div>
  </div>

  <script>
    document.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id     = (btn as HTMLElement).dataset.id;
        const active = (btn as HTMLElement).dataset.active === '1';
        const res = await fetch(`/api/documents/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_active: !active }),
        });
        if (res.ok) window.location.reload();
        else alert('เกิดข้อผิดพลาด');
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id    = (btn as HTMLElement).dataset.id;
        const title = (btn as HTMLElement).dataset.title;
        if (!confirm(`ต้องการลบเอกสาร "${title}" ใช่ไหม?\nการลบไม่สามารถกู้คืนได้`)) return;
        const res = await fetch(`/api/documents/${id}`, { method: 'DELETE' });
        if (res.ok) (btn as HTMLElement).closest('tr')?.remove();
        else alert('เกิดข้อผิดพลาดในการลบ');
      });
    });
  </script>
</AdminLayout>
