---
// AdminLayout.astro — โครงสร้างทุกหน้าใน Admin Panel
interface Props {
  title?: string;
  activeMenu?: 'dashboard' | 'documents' | 'standards' | 'indicators' | 'albums' | 'users';
}

const { title = 'Admin Panel', activeMenu } = Astro.props;
const session = Astro.locals.session;
---

<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Admin สมศ.</title>
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>body { font-family: 'Sarabun', sans-serif; }</style>
</head>
<body class="min-h-screen bg-gray-100">

  <!-- ===== SIDEBAR ===== -->
  <div class="flex min-h-screen">
    <aside class="w-60 bg-blue-900 text-white flex flex-col flex-shrink-0">
      <!-- Logo -->
      <div class="p-5 border-b border-blue-800">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🏫</span>
          <div>
            <p class="font-bold text-sm leading-tight">Admin Panel</p>
            <p class="text-blue-300 text-xs">ระบบเอกสาร สมศ. รอบห้า</p>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 p-4 space-y-1">
        <a href="/"
           class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                  ${activeMenu === 'dashboard' ? 'bg-blue-700 text-white' : 'text-blue-200 hover:bg-blue-800 hover:text-white'}`}>
          <span>📊</span> ภาพรวม
        </a>
        <a href="/documents"
           class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                  ${activeMenu === 'documents' ? 'bg-blue-700 text-white' : 'text-blue-200 hover:bg-blue-800 hover:text-white'}`}>
          <span>📄</span> จัดการเอกสาร
        </a>
        <a href="/documents/new?level=basic"
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium
                  text-blue-200 hover:bg-blue-800 hover:text-white transition-colors ml-4">
          <span>➕</span> เพิ่มเอกสาร (ขั้นพื้นฐาน)
        </a>
        <a href="/documents/new?level=early"
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium
                  text-pink-300 hover:bg-pink-900 hover:text-white transition-colors ml-4">
          <span>➕</span> เพิ่มเอกสาร (ปฐมวัย)
        </a>
        <a href="/standards"
           class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                  ${activeMenu === 'standards' ? 'bg-blue-700 text-white' : 'text-blue-200 hover:bg-blue-800 hover:text-white'}`}>
          <span>🏆</span> มาตรฐาน
        </a>
        <a href="/standards/new"
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium
                  text-blue-200 hover:bg-blue-800 hover:text-white transition-colors ml-4">
          <span>➕</span> เพิ่มมาตรฐาน
        </a>
        <a href="/indicators"
           class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                  ${activeMenu === 'indicators' ? 'bg-blue-700 text-white' : 'text-blue-200 hover:bg-blue-800 hover:text-white'}`}>
          <span>📋</span> ตัวชี้วัด
        </a>
        <a href="/indicators/new?level=basic"
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium
                  text-blue-200 hover:bg-blue-800 hover:text-white transition-colors ml-4">
          <span>➕</span> เพิ่มตัวชี้วัด (ขั้นพื้นฐาน)
        </a>
        <a href="/indicators/new?level=early"
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium
                  text-pink-300 hover:bg-pink-900 hover:text-white transition-colors ml-4">
          <span>➕</span> เพิ่มตัวชี้วัด (ปฐมวัย)
        </a>
        <a href="/albums"
           class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                  ${activeMenu === 'albums' ? 'bg-purple-700 text-white' : 'text-purple-300 hover:bg-purple-900 hover:text-white'}`}>
          <span>📷</span> คลังภาพ
        </a>
        {session?.role === 'admin' && (
          <a href="/users"
             class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                    ${activeMenu === 'users' ? 'bg-blue-700 text-white' : 'text-blue-200 hover:bg-blue-800 hover:text-white'}`}>
            <span>👥</span> ผู้ใช้งาน
          </a>
        )}
      </nav>

      <!-- User info + Logout -->
      <div class="p-4 border-t border-blue-800">
        <p class="text-xs text-blue-400 mb-2 truncate">{session?.email}</p>
        <form action="/api/auth/logout" method="POST">
          <button type="submit"
                  class="w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-sm
                         text-blue-300 hover:bg-blue-800 hover:text-white transition-colors">
            <span>🚪</span> ออกจากระบบ
          </button>
        </form>
      </div>
    </aside>

    <!-- ===== MAIN AREA ===== -->
    <div class="flex-1 flex flex-col min-w-0">

      <!-- Top bar -->
      <header class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between">
        <h1 class="text-lg font-bold text-gray-800">{title}</h1>
        <!-- Rebuild button -->
        <button
          id="rebuildBtn"
          class="flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white
                 text-sm font-medium px-4 py-2 rounded-lg transition-colors"
          title="Rebuild เว็บไซต์สาธารณะหลังบันทึกข้อมูลใหม่"
        >
          <span>🔄</span>
          <span id="rebuildText">Rebuild เว็บไซต์</span>
        </button>
      </header>

      <!-- Page content -->
      <main class="flex-1 p-6">
        <slot />
      </main>
    </div>
  </div>

  <!-- Rebuild script -->
  <script is:inline>
    const btn  = document.getElementById('rebuildBtn');
    const text = document.getElementById('rebuildText');

    let pollTimer = null;
    let triggeredAt = null;

    async function pollStatus() {
      try {
        const res  = await fetch('/api/rebuild-status');
        const data = await res.json();

        // นับเฉพาะ run ที่เริ่มหลังจากที่เรากด rebuild
        if (triggeredAt && data.started_at) {
          const startedAt = new Date(data.started_at).getTime();
          if (startedAt < triggeredAt - 5000) return; // run เก่า ข้ามไป
        }

        if (data.status === 'completed') {
          clearInterval(pollTimer);
          pollTimer = null;
          btn.disabled = false;

          if (data.conclusion === 'success') {
            text.textContent = '✅ เสร็จแล้ว!';
            showNotification('✅ Rebuild สำเร็จ!', 'เว็บไซต์สาธารณะได้รับการอัปเดตแล้ว');
            setTimeout(() => { text.textContent = 'Rebuild เว็บไซต์'; }, 5000);
          } else {
            text.textContent = '❌ มีข้อผิดพลาด';
            showNotification('❌ Rebuild ล้มเหลว', 'กรุณาตรวจสอบ GitHub Actions');
            setTimeout(() => { text.textContent = 'Rebuild เว็บไซต์'; }, 5000);
          }
        } else {
          const elapsed = triggeredAt ? Math.round((Date.now() - triggeredAt) / 1000) : 0;
          text.textContent = `กำลัง Rebuild... (${elapsed}s)`;
        }
      } catch {}
    }

    function showNotification(title, body) {
      // Browser Notification
      if ('Notification' in window && Notification.permission === 'granted') {
        new Notification(title, { body, icon: '/favicon.svg' });
      } else {
        // fallback — แสดงแถบแจ้งเตือนบนหน้าเว็บ
        const bar = document.createElement('div');
        bar.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:9999;padding:12px 20px;text-align:center;font-family:Sarabun,sans-serif;font-size:14px;font-weight:600;';
        bar.style.background = title.startsWith('✅') ? '#16a34a' : '#dc2626';
        bar.style.color = 'white';
        bar.textContent = title + ' — ' + body;
        document.body.prepend(bar);
        setTimeout(() => bar.remove(), 6000);
      }
    }

    btn?.addEventListener('click', async () => {
      if (!confirm('ต้องการ Rebuild เว็บไซต์สาธารณะเพื่ออัปเดตข้อมูลใหม่ใช่ไหม?\n(ใช้เวลาประมาณ 1-2 นาที)')) return;

      // ขอสิทธิ์แจ้งเตือน
      if ('Notification' in window && Notification.permission === 'default') {
        await Notification.requestPermission();
      }

      btn.disabled = true;
      text.textContent = 'กำลังเริ่ม...';
      triggeredAt = Date.now();

      try {
        const res  = await fetch('/api/rebuild', { method: 'POST' });
        const data = await res.json();

        if (res.ok) {
          text.textContent = 'กำลัง Rebuild... (0s)';
          // poll ทุก 10 วินาที
          pollTimer = setInterval(pollStatus, 10000);
          // poll ครั้งแรกหลัง 15 วินาที (รอ GitHub Actions เริ่มทำงาน)
          setTimeout(pollStatus, 15000);
        } else {
          btn.disabled = false;
          text.textContent = 'Rebuild เว็บไซต์';
          alert('❌ เกิดข้อผิดพลาด: ' + data.error);
        }
      } catch {
        btn.disabled = false;
        text.textContent = 'Rebuild เว็บไซต์';
        alert('❌ ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
      }
    });
  </script>
</body>
</html>
