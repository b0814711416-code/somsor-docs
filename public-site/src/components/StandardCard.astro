---
interface Props {
  id: number;
  code: string;
  name: string;
  description?: string | null;
  icon: string;
  color: string;
  indicatorCount: number;
  documentCount: number;
}

const { code, name, description, icon, color, indicatorCount, documentCount } = Astro.props;
const BASE = import.meta.env.BASE_URL;

const colorMap: Record<string, {
  border: string; headerBg: string; badge: string;
  text: string; hoverBorder: string; hoverShadow: string; dot: string;
}> = {
  blue:   {
    border: 'border-blue-200', headerBg: 'bg-blue-600',
    badge: 'bg-blue-100 text-blue-700', text: 'group-hover:text-blue-700',
    hoverBorder: 'hover:border-blue-400', hoverShadow: 'hover:shadow-blue-100', dot: 'bg-blue-500',
  },
  green:  {
    border: 'border-green-200', headerBg: 'bg-green-600',
    badge: 'bg-green-100 text-green-700', text: 'group-hover:text-green-700',
    hoverBorder: 'hover:border-green-400', hoverShadow: 'hover:shadow-green-100', dot: 'bg-green-500',
  },
  purple: {
    border: 'border-purple-200', headerBg: 'bg-purple-600',
    badge: 'bg-purple-100 text-purple-700', text: 'group-hover:text-purple-700',
    hoverBorder: 'hover:border-purple-400', hoverShadow: 'hover:shadow-purple-100', dot: 'bg-purple-500',
  },
  orange: {
    border: 'border-orange-200', headerBg: 'bg-orange-500',
    badge: 'bg-orange-100 text-orange-700', text: 'group-hover:text-orange-700',
    hoverBorder: 'hover:border-orange-400', hoverShadow: 'hover:shadow-orange-100', dot: 'bg-orange-500',
  },
  pink:   {
    border: 'border-pink-200', headerBg: 'bg-pink-500',
    badge: 'bg-pink-100 text-pink-700', text: 'group-hover:text-pink-700',
    hoverBorder: 'hover:border-pink-400', hoverShadow: 'hover:shadow-pink-100', dot: 'bg-pink-500',
  },
};
const c = colorMap[color] ?? colorMap.blue;

const hasDocuments = documentCount > 0;
---

<a
  href={`${BASE}/standard/${code}`}
  class={`group flex flex-col bg-white rounded-2xl border-2 ${c.border}
         overflow-hidden transition-all duration-200 hover:shadow-lg ${c.hoverBorder} ${c.hoverShadow}`}
>
  <!-- แถบสีด้านบน -->
  <div class={`${c.headerBg} px-5 py-3 flex items-center justify-between`}>
    <div class="flex items-center gap-2">
      <span class="text-white text-lg">{icon}</span>
      <span class="text-white text-xs font-bold tracking-wide opacity-90">
        มาตรฐานที่ {code}
      </span>
    </div>
    <!-- สถานะเอกสาร -->
    <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${
      hasDocuments
        ? 'bg-white/20 text-white'
        : 'bg-white/10 text-white/60'
    }`}>
      {hasDocuments ? `${documentCount} เอกสาร` : 'รอเพิ่มเอกสาร'}
    </span>
  </div>

  <!-- เนื้อหา -->
  <div class="flex flex-col flex-1 p-5">
    <h2 class={`text-sm font-bold text-gray-800 leading-snug mb-2 ${c.text} transition-colors`}>
      {name}
    </h2>

    {description && (
      <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 mb-4 flex-1">
        {description}
      </p>
    )}

    <!-- Stats row -->
    <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-100">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1">
          <div class={`w-2 h-2 rounded-full ${c.dot}`}></div>
          <span class="text-xs text-gray-600 font-medium">{indicatorCount} ตัวชี้วัด</span>
        </div>
        <div class="flex items-center gap-1">
          <div class={`w-2 h-2 rounded-full ${hasDocuments ? 'bg-green-500' : 'bg-gray-300'}`}></div>
          <span class="text-xs text-gray-600 font-medium">{documentCount} เอกสาร</span>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300 group-hover:text-gray-500 transition-colors"
           fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"/>
      </svg>
    </div>
  </div>
</a>
