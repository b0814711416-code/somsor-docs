---
interface Props {
  title: string;
  url: string;
  academic_year: string;
  doc_type: string;
}

const { title, url, academic_year, doc_type } = Astro.props;

// สีตามประเภทเอกสาร
const typeStyles: Record<string, { bg: string; text: string; border: string }> = {
  'รายงาน':   { bg: 'bg-blue-50',   text: 'text-blue-700',   border: 'border-blue-200' },
  'แผน':      { bg: 'bg-green-50',  text: 'text-green-700',  border: 'border-green-200' },
  'คำสั่ง':   { bg: 'bg-orange-50', text: 'text-orange-700', border: 'border-orange-200' },
  'ภาพถ่าย':  { bg: 'bg-purple-50', text: 'text-purple-700', border: 'border-purple-200' },
  'สถิติ':    { bg: 'bg-teal-50',   text: 'text-teal-700',   border: 'border-teal-200' },
  'สรุป':     { bg: 'bg-yellow-50', text: 'text-yellow-700', border: 'border-yellow-200' },
  'นวัตกรรม': { bg: 'bg-pink-50',   text: 'text-pink-700',   border: 'border-pink-200' },
};
const style = typeStyles[doc_type] ?? { bg: 'bg-gray-50', text: 'text-gray-600', border: 'border-gray-200' };

// ไอคอนตามประเภท
const typeIcons: Record<string, string> = {
  'รายงาน':   '📄', 'แผน': '📋', 'คำสั่ง': '📜',
  'ภาพถ่าย':  '🖼️', 'สถิติ': '📊', 'สรุป': '📝',
  'นวัตกรรม': '💡',
};
const icon = typeIcons[doc_type] ?? '📎';
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-start gap-3 p-3.5 rounded-xl border border-gray-200 bg-white
         hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-md
         transition-all duration-150"
>
  <!-- ไอคอนประเภทเอกสาร -->
  <div class={`flex-shrink-0 w-9 h-9 rounded-lg ${style.bg} border ${style.border}
               flex items-center justify-center text-base`}>
    {icon}
  </div>

  <!-- ชื่อและ badges -->
  <div class="flex-1 min-w-0">
    <p class="text-sm font-semibold text-gray-800 group-hover:text-blue-700
              leading-snug line-clamp-2 transition-colors">
      {title}
    </p>
    <div class="mt-1.5 flex items-center gap-1.5 flex-wrap">
      <span class={`text-xs px-2 py-0.5 rounded-full border font-medium ${style.bg} ${style.text} ${style.border}`}>
        {doc_type}
      </span>
      <span class="text-xs text-gray-400">ปีการศึกษา {academic_year}</span>
    </div>
  </div>

  <!-- ไอคอนเปิดลิงก์ -->
  <div class="flex-shrink-0 mt-1 opacity-0 group-hover:opacity-100 transition-opacity">
    <div class="w-6 h-6 rounded-md bg-blue-600 flex items-center justify-center">
      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    </div>
  </div>
</a>
