---
import DocumentLink from './DocumentLink.astro';

interface Document {
  id: number;
  title: string;
  url: string;
  academic_year: string;
  doc_type: string;
}

interface Props {
  code: string;
  name: string;
  description?: string | null;
  documents: Document[];
}

const { code, name, description, documents } = Astro.props;
const activeDocs = documents?.filter(d => d) ?? [];
const hasDocuments = activeDocs.length > 0;
---

<div class="mb-5 bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

  <!-- หัวตัวชี้วัด -->
  <div class={`px-5 py-4 flex items-start gap-4 border-b ${hasDocuments ? 'border-gray-200 bg-gray-50' : 'border-dashed border-gray-200 bg-gray-50/50'}`}>
    <!-- รหัส badge -->
    <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center
                text-white text-sm font-bold shadow-sm">
      {code}
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-sm font-bold text-gray-800 leading-snug">
          ตัวชี้วัดที่ {code}: {name}
        </h3>
        <!-- จำนวนเอกสาร -->
        <span class={`flex-shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full ${
          hasDocuments
            ? 'bg-green-100 text-green-700 border border-green-200'
            : 'bg-gray-100 text-gray-400 border border-gray-200'
        }`}>
          {hasDocuments ? `${activeDocs.length} เอกสาร` : 'ยังไม่มีเอกสาร'}
        </span>
      </div>
      {description && (
        <p class="text-xs text-gray-500 mt-1 leading-relaxed">{description}</p>
      )}
    </div>
  </div>

  <!-- รายการเอกสาร -->
  <div class="p-4">
    {hasDocuments ? (
      <div class="grid gap-2 sm:grid-cols-2">
        {activeDocs.map((doc) => (
          <DocumentLink
            title={doc.title}
            url={doc.url}
            academic_year={doc.academic_year}
            doc_type={doc.doc_type}
          />
        ))}
      </div>
    ) : (
      <div class="flex items-center gap-2 py-3 px-2">
        <div class="w-1 h-8 bg-gray-200 rounded-full"></div>
        <p class="text-sm text-gray-400 italic">ยังไม่มีเอกสารหลักฐานในตัวชี้วัดนี้</p>
      </div>
    )}
  </div>
</div>
