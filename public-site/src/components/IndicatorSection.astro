---
// IndicatorSection.astro — แสดงตัวชี้วัด 1 ตัว พร้อมเอกสารทั้งหมด
import DocumentLink from './DocumentLink.astro';

interface Document {
  id: number;
  title: string;
  url: string;
  academic_year: string;
  doc_type: string;
}

interface Props {
  code: string;
  name: string;
  description?: string | null;
  documents: Document[];
}

const { code, name, description, documents } = Astro.props;
const activeDocuments = documents?.filter(d => d) ?? [];
---

<div class="mb-6 border border-gray-200 rounded-xl overflow-hidden bg-white shadow-sm">

  <!-- Indicator Header -->
  <div class="bg-gray-50 border-b border-gray-200 px-5 py-3 flex items-start gap-3">
    <!-- รหัสตัวชี้วัด badge -->
    <span class="mt-0.5 flex-shrink-0 inline-flex items-center justify-center
                 w-9 h-9 rounded-lg bg-blue-600 text-white text-sm font-bold shadow-sm">
      {code}
    </span>
    <div>
      <h3 class="font-semibold text-gray-800 leading-snug">
        ตัวชี้วัดที่ {code}: {name}
      </h3>
      {description && (
        <p class="text-sm text-gray-500 mt-0.5 leading-relaxed">{description}</p>
      )}
    </div>
  </div>

  <!-- Document List -->
  <div class="p-4">
    {activeDocuments.length > 0 ? (
      <div class="grid gap-2 sm:grid-cols-2">
        {activeDocuments.map((doc) => (
          <DocumentLink
            title={doc.title}
            url={doc.url}
            academic_year={doc.academic_year}
            doc_type={doc.doc_type}
          />
        ))}
      </div>
    ) : (
      <p class="text-sm text-gray-400 italic py-2 text-center">
        — ยังไม่มีเอกสารหลักฐาน —
      </p>
    )}
  </div>

  <!-- สรุปจำนวนเอกสาร -->
  {activeDocuments.length > 0 && (
    <div class="bg-gray-50 border-t border-gray-100 px-5 py-2">
      <p class="text-xs text-gray-400">
        เอกสารทั้งหมด {activeDocuments.length} รายการ
      </p>
    </div>
  )}
</div>
