---
import Layout from '../../layouts/Layout.astro';
import IndicatorSection from '../../components/IndicatorSection.astro';
import { getAllStandardCodes, getStandardByCode } from '../../lib/db';

export async function getStaticPaths() {
  const codes = await getAllStandardCodes();
  return codes.map(code => ({ params: { code } }));
}

const { code } = Astro.params;
const standard = await getStandardByCode(code);

if (!standard) return Astro.redirect('/');

const BASE = import.meta.env.BASE_URL;

const totalDocs = standard.indicators.reduce(
  (sum, i) => sum + ((i as any).documents?.length ?? 0), 0
);
const totalIndicators = standard.indicators.length;

const colorMap: Record<string, { header: string; badge: string; accent: string }> = {
  blue:   { header: 'from-blue-700 to-blue-600',   badge: 'bg-blue-600',   accent: 'text-blue-600' },
  green:  { header: 'from-green-700 to-green-600', badge: 'bg-green-600',  accent: 'text-green-600' },
  purple: { header: 'from-purple-700 to-purple-600',badge: 'bg-purple-600',accent: 'text-purple-600' },
  orange: { header: 'from-orange-600 to-orange-500',badge: 'bg-orange-500',accent: 'text-orange-600' },
  pink:   { header: 'from-pink-600 to-pink-500',   badge: 'bg-pink-500',   accent: 'text-pink-600' },
};
const c = colorMap[(standard as any).color] ?? colorMap.blue;
const level = (standard as any).education_level;
---

<Layout title={`มาตรฐานที่ ${standard.code}: ${standard.name}`}>

  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6 flex-wrap">
    <a href={BASE + '/'} class="hover:text-blue-600 transition-colors">หน้าหลัก</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
    <a href={`${BASE}/${level === 'early' ? 'early' : 'basic'}`}
       class="hover:text-blue-600 transition-colors">
      {level === 'early' ? 'ระดับปฐมวัย' : 'ระดับขั้นพื้นฐาน'}
    </a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
    <span class="text-gray-800 font-medium">มาตรฐานที่ {standard.code}</span>
  </nav>

  <!-- Standard Header Card -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-8">
    <!-- Gradient header strip -->
    <div class={`bg-gradient-to-r ${c.header} px-6 py-5 text-white`}>
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-white/20 ring-2 ring-white/30
                    flex items-center justify-center text-3xl">
          {standard.icon}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <span class="bg-white/20 text-white text-xs font-bold px-3 py-0.5 rounded-full">
              มาตรฐานที่ {standard.code}
            </span>
            <span class="text-white/70 text-xs">
              {level === 'early' ? '🌸 ระดับปฐมวัย' : '🎓 ระดับขั้นพื้นฐาน'}
            </span>
          </div>
          <h1 class="text-lg font-bold leading-snug">
            {standard.name}
          </h1>
        </div>
      </div>
    </div>

    <!-- Description & Stats -->
    <div class="px-6 py-5">
      {standard.description && (
        <p class="text-gray-600 text-sm leading-relaxed mb-4">{standard.description}</p>
      )}
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-2">
          <div class={`w-3 h-3 rounded-full ${c.badge}`}></div>
          <span class="text-sm text-gray-700">
            <strong class="font-bold">{totalIndicators}</strong> ตัวชี้วัด
          </span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <span class="text-sm text-gray-700">
            <strong class="font-bold">{totalDocs}</strong> เอกสารหลักฐาน
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Indicators -->
  <div class="mb-4 flex items-center gap-2">
    <div class={`w-1 h-5 rounded-full ${c.badge}`}></div>
    <h2 class="text-base font-bold text-gray-700">ตัวชี้วัดและเอกสารหลักฐาน</h2>
  </div>

  {standard.indicators.length > 0 ? (
    standard.indicators.map((indicator) => (
      <IndicatorSection
        code={indicator.code}
        name={indicator.name}
        description={indicator.description}
        documents={(indicator as any).documents ?? []}
      />
    ))
  ) : (
    <div class="text-center py-14 bg-white rounded-2xl border border-dashed border-gray-300">
      <p class="text-3xl mb-2">📭</p>
      <p class="text-gray-500">ยังไม่มีตัวชี้วัดในมาตรฐานนี้</p>
    </div>
  )}

  <!-- Back link -->
  <div class="mt-8 pt-6 border-t border-gray-200 text-center">
    <a href={`${BASE}/${level === 'early' ? 'early' : 'basic'}`}
       class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-blue-600 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
      </svg>
      กลับรายการมาตรฐาน{level === 'early' ? 'ระดับปฐมวัย' : 'ระดับขั้นพื้นฐาน'}
    </a>
  </div>

</Layout>
