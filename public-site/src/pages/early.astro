---
import Layout from '../layouts/Layout.astro';
import StandardCard from '../components/StandardCard.astro';
import { getFullDataByLevel } from '../lib/db';

const standards = await getFullDataByLevel('early');
const totalIndicators = standards.reduce((sum, s) => sum + (s.indicators?.length ?? 0), 0);
const totalDocuments  = standards.reduce((sum, s) =>
  sum + (s.indicators?.reduce((iSum, i) => iSum + (i.documents?.length ?? 0), 0) ?? 0), 0);

const BASE = import.meta.env.BASE_URL;
---

<Layout title="ระดับปฐมวัย — ระบบเอกสาร สมศ. รอบห้า">

  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <a href={BASE + '/'} class="hover:text-pink-600 transition-colors flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      หน้าหลัก
    </a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
    <span class="text-gray-800 font-medium">ระดับปฐมวัย</span>
  </nav>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-8">
    <div class="h-1.5 bg-gradient-to-r from-pink-500 to-pink-400"></div>
    <div class="p-6">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-4xl">🌸</span>
        <div>
          <h1 class="text-xl font-bold text-gray-800">ระดับปฐมวัย</h1>
          <p class="text-sm text-gray-500">Early Childhood Education — เอกสารหลักฐานตามมาตรฐานและตัวชี้วัด</p>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div class="text-center bg-pink-50 rounded-xl py-3 border border-pink-100">
          <p class="text-2xl font-bold text-pink-600">{standards.length}</p>
          <p class="text-xs text-gray-500 mt-0.5">มาตรฐาน</p>
        </div>
        <div class="text-center bg-slate-50 rounded-xl py-3 border border-slate-100">
          <p class="text-2xl font-bold text-slate-700">{totalIndicators}</p>
          <p class="text-xs text-gray-500 mt-0.5">ตัวชี้วัด</p>
        </div>
        <div class="text-center bg-green-50 rounded-xl py-3 border border-green-100">
          <p class="text-2xl font-bold text-green-700">{totalDocuments}</p>
          <p class="text-xs text-gray-500 mt-0.5">เอกสาร</p>
        </div>
      </div>
    </div>
  </div>

  {standards.length > 0 ? (
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {standards.map((standard) => {
        const indicatorCount = standard.indicators?.length ?? 0;
        const documentCount  = standard.indicators?.reduce(
          (sum, i) => sum + (i.documents?.length ?? 0), 0) ?? 0;
        return (
          <StandardCard
            id={standard.id}
            code={standard.code}
            name={standard.name}
            description={standard.description}
            icon={standard.icon}
            color="pink"
            indicatorCount={indicatorCount}
            documentCount={documentCount}
          />
        );
      })}
    </div>
  ) : (
    <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-gray-300">
      <p class="text-4xl mb-3">📭</p>
      <p class="text-gray-500 font-medium">ยังไม่มีข้อมูลมาตรฐาน</p>
      <p class="text-gray-400 text-sm mt-1">กรุณาเพิ่มข้อมูลผ่าน Admin Panel</p>
    </div>
  )}

  <div class="mt-8 pt-6 border-t border-gray-200 text-center">
    <a href={BASE + '/'} class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-pink-600 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
      </svg>
      กลับหน้าเลือกระดับการศึกษา
    </a>
  </div>

</Layout>
