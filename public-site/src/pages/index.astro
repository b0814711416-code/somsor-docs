---
import Layout from '../layouts/Layout.astro';
import { getLevelStats } from '../lib/db';

const stats = await getLevelStats();
const BASE = import.meta.env.BASE_URL;
---

<Layout title="ระบบเอกสารหลักฐาน สมศ. รอบห้า — เลือกระดับการศึกษา">

  <div class="min-h-[60vh] flex flex-col items-center justify-center py-12">

    <div class="text-center mb-10">
      <h1 class="text-2xl font-bold text-gray-800 mb-2">เลือกระดับการศึกษา</h1>
      <p class="text-gray-500">กรุณาเลือกระดับการศึกษาที่ต้องการประเมิน</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 w-full max-w-2xl">

      <!-- ขั้นพื้นฐาน -->
      <a href={BASE + '/basic'}
         class="group block bg-white rounded-2xl border-2 border-blue-200 hover:border-blue-500
                hover:shadow-xl hover:shadow-blue-100 transition-all duration-200 p-8 text-center">
        <div class="text-5xl mb-4">🎓</div>
        <h2 class="text-lg font-bold text-gray-800 group-hover:text-blue-700 transition-colors mb-1">
          ระดับการศึกษาขั้นพื้นฐาน
        </h2>
        <p class="text-sm text-gray-500 mb-6">Basic Education</p>
        <div class="flex justify-center gap-6 text-center">
          <div>
            <p class="text-2xl font-bold text-blue-600">{stats.basic.standards}</p>
            <p class="text-xs text-gray-400">มาตรฐาน</p>
          </div>
          <div class="w-px bg-gray-200"></div>
          <div>
            <p class="text-2xl font-bold text-blue-600">{stats.basic.indicators}</p>
            <p class="text-xs text-gray-400">ตัวบ่งชี้</p>
          </div>
          <div class="w-px bg-gray-200"></div>
          <div>
            <p class="text-2xl font-bold text-blue-600">{stats.basic.documents}</p>
            <p class="text-xs text-gray-400">เอกสาร</p>
          </div>
        </div>
        <div class="mt-6">
          <span class="inline-flex items-center gap-2 bg-blue-600 group-hover:bg-blue-700
                       text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors">
            เข้าดูเอกสาร →
          </span>
        </div>
      </a>

      <!-- ปฐมวัย -->
      <a href={BASE + '/early'}
         class="group block bg-white rounded-2xl border-2 border-pink-200 hover:border-pink-500
                hover:shadow-xl hover:shadow-pink-100 transition-all duration-200 p-8 text-center">
        <div class="text-5xl mb-4">🌸</div>
        <h2 class="text-lg font-bold text-gray-800 group-hover:text-pink-700 transition-colors mb-1">
          ระดับปฐมวัย
        </h2>
        <p class="text-sm text-gray-500 mb-6">Early Childhood Education</p>
        <div class="flex justify-center gap-6 text-center">
          <div>
            <p class="text-2xl font-bold text-pink-600">{stats.early.standards}</p>
            <p class="text-xs text-gray-400">มาตรฐาน</p>
          </div>
          <div class="w-px bg-gray-200"></div>
          <div>
            <p class="text-2xl font-bold text-pink-600">{stats.early.indicators}</p>
            <p class="text-xs text-gray-400">ตัวบ่งชี้</p>
          </div>
          <div class="w-px bg-gray-200"></div>
          <div>
            <p class="text-2xl font-bold text-pink-600">{stats.early.documents}</p>
            <p class="text-xs text-gray-400">เอกสาร</p>
          </div>
        </div>
        <div class="mt-6">
          <span class="inline-flex items-center gap-2 bg-pink-600 group-hover:bg-pink-700
                       text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors">
            เข้าดูเอกสาร →
          </span>
        </div>
      </a>

    </div>
  </div>

</Layout>
