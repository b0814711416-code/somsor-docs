# Connection string จาก Neon.tech Dashboard → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ข้อมูลโรงเรียน (แสดงบน header)
SCHOOL_NAME="โรงเรียนตัวอย่าง"
SCHOOL_SUBTITLE="สำนักงานเขตพื้นที่การศึกษามัธยมศึกษา เขต XX"
